{
  "_comment": "Lobster School Hardened Configuration v1.0 — Safe defaults, human can loosen as needed",

  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_STRONG_RANDOM_TOKEN"
    }
  },

  "session": {
    "dmScope": "per-channel-peer"
  },

  "agents": {
    "defaults": {
      "workspace": "~/openclaw",
      "skipBootstrap": true,
      "compaction": {
        "memoryFlush": {
          "enabled": true
        }
      },
      "memorySearch": {
        "enabled": true,
        "sources": ["memory", "sessions"],
        "experimental": {
          "sessionMemory": true
        }
      }
    }
  },

  "tools": {
    "profile": "messaging",
    "deny": [
      "group:automation",
      "group:runtime",
      "sessions_spawn",
      "sessions_send"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "security": "ask",
      "ask": "always",
      "host": "sandbox"
    },
    "elevated": {
      "enabled": false
    }
  },

  "channels": {
    "whatsapp": {
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    },
    "telegram": {
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    },
    "discord": {
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },

  "hooks": {
    "boot": {
      "enabled": true,
      "file": "BOOT.md"
    },
    "heartbeat": {
      "enabled": true,
      "file": "HEARTBEAT.md",
      "interval": "5m"
    }
  },

  "_lobster_school": {
    "version": "1.0.0",
    "graduated": true,
    "installed_at": "",
    "notes": "This config was generated by Lobster School. Gateway is local-only with token auth. Exec requires approval. Filesystem restricted to workspace. Group chats require @mention. Hooks enabled for boot ritual and heartbeat monitoring. To loosen restrictions, edit specific sections — don't replace the whole file."
  }
}
